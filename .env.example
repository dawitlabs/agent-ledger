# --- Supabase (Postgres + Auth + Realtime) ---
# Create a project at https://supabase.com then run supabase/migrations/001_initial.sql
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional client mirrors (set the same values in Vercel for browser Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- OpenAI / AI Gateway (Vercel AI SDK agent) ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_GATEWAY_API_KEY=

# --- Optional durable runs (Inngest) ---
# INNGEST_EVENT_KEY=

# Without these vars the app runs in local demo mode (file store + simulated agent).
